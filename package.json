{
  "name": "amp-elixir-phoenix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Elixir and Phoenix workflow skills, palette commands, and specialists for Amp",
  "scripts": {
    "hosted:publish": "node scripts/publish-amp-hosted.mjs",
    "lint": "markdownlint \"README.md\" \"docs/**/*.md\" \"skills/**/*.md\"",
    "manifest:check": "node scripts/generate-manifest.mjs --check",
    "manifest:update": "node scripts/generate-manifest.mjs",
    "sync:canonical": "node scripts/sync-canonical.mjs",
    "sync:canonical:check": "node scripts/sync-canonical.mjs --check",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-distribution.mjs",
    "test:plugin": "tsx scripts/plugin-harness.ts plugins/elixir-phoenix.ts skills",
    "test:publisher": "node --test scripts/tests/publish-amp-hosted.test.mjs",
    "test:watcher": "tsx scripts/tests/amp_watch_pr_harness.mts plugins/phx-watch-pr.ts .",
    "test": "npm run manifest:check && npm run verify && npm run typecheck && npm run test:plugin && npm run test:watcher && npm run test:publisher && npm run lint"
  },
  "devDependencies": {
    "@ampcode/plugin": "0.0.0-20260818001058-gcb0a91a",
    "@types/node": "26.1.1",
    "markdownlint-cli": "0.49.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oliver-kriska/amp-elixir-phoenix.git"
  },
  "author": "Oliver Kriska",
  "license": "MIT"
}
